# Application
APP_ENV=production
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
ADMIN_ID=123456789
LOGS_CHAT_ID=-1001234567890
ANTI_SPAM_SECONDS=5
OTP_ISSUER=Ghost OTP Bot

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ghost_bot
DB_USER=ghost_bot
DB_PASSWORD=

# Telegram messaging webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org

# Provider-neutral call status webhook
CALL_WEBHOOK_SECRET=

# Stripe sandbox only. Users supply their own sk_test_ key through the bot.
STRIPE_API_BASE=https://api.stripe.com/v1
STRIPE_TEST_AMOUNT=50
STRIPE_TEST_CURRENCY=usd

# Optional. {bin} is replaced with a validated 6-8 digit BIN.
# Example provider shape: scheme, type, brand, bank.name, country.name
BIN_LOOKUP_URL=https://lookup.binlist.net/{bin}

# NVIDIA chat settings
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=
NVIDIA_MAX_TOKENS=65536
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_REASONING_BUDGET=16384
NVIDIA_TIMEOUT=60
