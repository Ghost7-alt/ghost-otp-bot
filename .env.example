# Ghost OTP Bot Configuration

# Bot settings
BOT_NAME=Ghost OTP Bot
BOT_ISSUER=Ghost OTP Bot

# Automaton settings (when integrating with Automaton)
# AUTOMATON_PATH=./automaton
# AUTOMATON_INTERFACE=stdio

# OTP settings
OTP_ISSUER=Ghost OTP Bot
QR_CODE_OUTPUT_PATH=./qr_codes/

# NVIDIA chat settings
# NVIDIA_API_KEY=nvapi-...
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TIMEOUT=60

# Security
SECRET_BACKUP_PATH=./secrets/
